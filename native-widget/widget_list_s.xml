<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано native-widget/gen-layouts.js — руками не править. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
    android:scaleType="fitXY" android:src="@drawable/widget_bg" android:tint="#FFFFFF" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/w_content" android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="13dp" android:paddingEnd="13dp" android:paddingTop="12dp" android:paddingBottom="11dp">
    <LinearLayout android:id="@+id/w_head_box" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" >
      <ImageView android:id="@+id/w_live_dot" android:layout_width="7dp" android:layout_height="7dp"
    android:src="@drawable/widget_dot" android:tint="#2F62EA" android:importantForAccessibility="no" android:layout_marginEnd="6dp" />
      <TextView android:id="@+id/w_head" android:layout_width="0dp" android:layout_height="wrap_content"
    android:textSize="13dp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#10131A"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="Сегодня, суббота" android:layout_weight="1" />
      <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="13dp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#2856D6" android:includeFontPadding="false" android:singleLine="true"
          android:layout_marginStart="8dp" />
      <TextView android:id="@+id/w_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="13dp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#2856D6"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="08:00" android:layout_marginStart="8dp" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <ImageView android:id="@+id/w_room_img" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_gravity="start|center_vertical" android:adjustViewBounds="true" android:maxHeight="60dp" android:maxWidth="600dp"
          android:scaleType="fitStart" android:src="@drawable/widget_room_sample" android:tint="#2856D6" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/w_subj" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13dp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#10131A" android:includeFontPadding="false"
        android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" android:text="Численные методы" />
    <LinearLayout android:id="@+id/w_after_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="7dp">
      <FrameLayout android:id="@+id/w_after_line" android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDE2EA" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
          android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/w_after" android:layout_width="0dp" android:layout_height="wrap_content"
    android:textSize="12dp" android:fontFamily="sans-serif-medium" android:textColor="#4B5262"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="III · 11:30" android:layout_weight="1" />
        <TextView android:id="@+id/w_after_room" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="17dp" android:fontFamily="sans-serif-black" android:textColor="#10131A"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="305" android:layout_marginStart="6dp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="16dp" android:visibility="gone">
    <TextView android:id="@+id/w_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="22dp" android:fontFamily="sans-serif-black" android:textColor="#10131A" android:gravity="center"
        android:includeFontPadding="false" android:text="Каникулы" />
    <TextView android:id="@+id/w_empty_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="13dp" android:fontFamily="sans-serif-medium" android:textColor="#4B5262"
        android:gravity="center" android:includeFontPadding="false" android:text="" />
  </LinearLayout>
</FrameLayout>
