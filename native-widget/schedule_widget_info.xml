<?xml version="1.0" encoding="utf-8"?>
<!-- «МГУ · Расписание» — «Список пар» (с 2.0.7, вместо «Табло»; класс ScheduleWidget — прежнее имя,
     уже поставленные виджеты сменят вид сами). 2×2 — своя раскладка, от 4×2 — строк столько,
     сколько влезает (ScheduleWidget.kt, planList). По умолчанию 4×2. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="100dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_list"
    android:previewLayout="@layout/widget_list"
    android:description="@string/widget_tablo_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
