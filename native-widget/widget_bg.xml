<?xml version="1.0" encoding="utf-8"?>
<!-- Подложка виджета: БЕЛАЯ скруглённая форма. Настоящий цвет (fill / soft /
     surface из widget_theme) ставит ScheduleWidget.kt через setColorFilter —
     перекраска картинки работает на всех версиях Android. Скругление 24 dp
     (ТЗ, раздел 1); на Android 12+ — системное, см. widget_bg_v31.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="24dp" />
</shape>
