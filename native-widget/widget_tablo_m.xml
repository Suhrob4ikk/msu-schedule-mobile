<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
    android:scaleType="fitXY" android:src="@drawable/widget_bg" android:tint="#2F62EA" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/w_content" android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="15dp" android:paddingBottom="14dp">
    <LinearLayout android:id="@+id/w_hero" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:orientation="vertical">
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
    <ImageView android:id="@+id/w_chip_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_plate" android:tint="#5981EE" android:importantForAccessibility="no" />
    <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="13dp" android:fontFamily="@font/onest_bold" android:textColor="#FFFFFF"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="Идёт · I пара" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
  </FrameLayout>
        <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="40dp" android:fontFamily="@font/onest_extrabold" android:textColor="#FFFFFF" android:includeFontPadding="false"
    android:singleLine="true" android:letterSpacing="-0.03" android:layout_marginTop="9dp" />
        <TextView android:id="@+id/w_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="24dp" android:fontFamily="@font/onest_extrabold" android:textColor="#FFFFFF"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="Завтра · 08:00" android:layout_marginTop="12dp" android:visibility="gone" />
        <TextView android:id="@+id/w_chrono_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="13dp" android:fontFamily="@font/onest_medium" android:textColor="#EAEFFD"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="до конца" android:layout_marginTop="4dp" />
      </LinearLayout>
      <TextView android:id="@+id/w_room" android:layout_width="0dp" android:layout_height="match_parent"
    android:fontFamily="@font/onest_extrabold" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1"
    android:letterSpacing="-0.04" android:gravity="end|bottom" android:text="104"
    android:textSize="72dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="32dp"
    android:autoSizeMaxTextSize="120dp" android:autoSizeStepGranularity="2dp" android:layout_weight="1" />
    </LinearLayout>
    <TextView android:id="@+id/w_subj" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="17dp" android:fontFamily="@font/onest_extrabold" android:textColor="#FFFFFF"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="Объектно-ориентированное программирование" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/w_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="13dp" android:fontFamily="@font/onest_medium" android:textColor="#EAEFFD"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="08:00–09:30 · Практика · Одилзода О.О." android:layout_marginTop="3dp" />
    <FrameLayout android:id="@+id/w_bar_box" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="9dp">
    <ImageView android:id="@+id/w_bar_track" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bar" android:tint="#5981EE" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_bar" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bar_fill" android:tint="#FFFFFF" android:importantForAccessibility="no" />
  </FrameLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="16dp" android:visibility="gone">
    <TextView android:id="@+id/w_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="22dp" android:fontFamily="@font/onest_extrabold" android:textColor="#10131A" android:gravity="center"
        android:includeFontPadding="false" android:text="Каникулы" />
    <TextView android:id="@+id/w_empty_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="13dp" android:fontFamily="@font/onest_medium" android:textColor="#4B5262"
        android:gravity="center" android:includeFontPadding="false" android:text="" />
  </LinearLayout>
</FrameLayout>
