<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано native-widget/gen-layouts.js — руками не править. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
    android:scaleType="fitXY" android:src="@drawable/widget_bg" android:tint="#2F62EA" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/w_content" android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp">
    <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
    <ImageView android:id="@+id/w_chip_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_plate" android:tint="#5981EE" android:importantForAccessibility="no" />
    <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="12dp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#FFFFFF"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="Идёт · I" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
  </FrameLayout>
    <ImageView android:id="@+id/w_room_img" android:layout_width="match_parent" android:layout_height="0dp"
    android:scaleType="fitStart" android:src="@drawable/widget_room_sample" android:tint="#FFFFFF" android:importantForAccessibility="no" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/w_subj" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="14dp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#FFFFFF"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="Объектно-ориентированное программирование"  />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="5dp">
      <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="14dp" android:fontFamily="sans-serif-black" android:textColor="#FFFFFF" android:includeFontPadding="false"
    android:singleLine="true" android:letterSpacing="-0.02"  />
      <TextView android:id="@+id/w_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="14dp" android:fontFamily="sans-serif-black" android:textColor="#FFFFFF"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="Завтра · 08:00" android:visibility="gone" />
      <TextView android:id="@+id/w_chrono_lbl" android:layout_width="0dp" android:layout_height="wrap_content"
    android:textSize="12dp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="#EAEFFD"
    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
    android:text="до конца" android:layout_weight="1" android:gravity="end" android:layout_marginStart="6dp" />
    </LinearLayout>
    <FrameLayout android:id="@+id/w_bar_box" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="6dp">
    <ImageView android:id="@+id/w_bar_track" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bar" android:tint="#5981EE" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_bar" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bar_fill" android:tint="#FFFFFF" android:importantForAccessibility="no" />
  </FrameLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="16dp" android:visibility="gone">
    <TextView android:id="@+id/w_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="22dp" android:fontFamily="sans-serif-black" android:textColor="#10131A" android:gravity="center"
        android:includeFontPadding="false" android:text="Каникулы" />
    <TextView android:id="@+id/w_empty_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="13dp" android:fontFamily="sans-serif-medium" android:textColor="#4B5262"
        android:gravity="center" android:includeFontPadding="false" android:text="" />
  </LinearLayout>
</FrameLayout>
