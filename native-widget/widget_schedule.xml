<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Следующая пара»: тёмная карточка в фирменном стиле Academic Emerald -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#2DD4A7"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="МГУ Расписание" />

        <TextView
            android:id="@+id/widget_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#E7EAEE"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Откройте приложение" />

        <TextView
            android:id="@+id/widget_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#8B94A3"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="чтобы загрузить расписание" />

        <!-- Обратный отсчёт до конца/начала пары. Скрыт по умолчанию (нет
             текущей/следующей пары — например, каникулы); заполняется кодом
             в ScheduleWidget.fmtDuration. Раньше на этом месте было просто
             пусто — карточка из двух строк текста в контейнере на всю высоту
             виджета выглядела недоделанной. -->
        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2DD4A7"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            android:text="" />

    </LinearLayout>

    <!-- Тающее кольцо прогресса — сколько осталось от пары/перемены. Рисуется
         в коде (ScheduleWidget.ringBitmap): RemoteViews не умеет кастомные View. -->
    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"
        android:visibility="gone" />

</LinearLayout>
